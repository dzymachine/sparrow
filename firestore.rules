rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny for unauthenticated/unmatched collections
    match /{document=**} {
      allow read, write: if false;
    }

    // User personal wiki documents (server Admin SDK bypasses rules, rules protect direct client access)
    match /user_wikis/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // User profile documents
    match /user_profiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
